perm-persistent-storage-remember = 今後も同様に処理する
speech-recognition-model-download-header = 音声認識をセットアップしますか？
# $sizeMB (Number) - the model download size in MB.
speech-recognition-model-download-message = { -brand-short-name } はローカルで音声認識を実行するため、音声はこの端末にしか残りません。セットアップを続けると、音声認識モデル ({ $sizeMB } MB 以下) のデータがダウンロードされます。
speech-recognition-model-download-allow =
    .label = 続行
    .accesskey = C
speech-recognition-model-download-not-now =
    .label = 後で
    .accesskey = N
speech-recognition-model-download-progress-message = 音声認識モデルをダウンロードしています
# Accessible name of the progress bar shown while the model downloads. The
# percentage and time remaining are rendered next to it, as text.
speech-recognition-model-download-progressbar =
    .aria-label = 音声認識モデルのダウンロード進捗状況
speech-recognition-model-download-cancel =
    .label = キャンセル
    .accesskey = C
speech-recognition-model-download-complete-message = 音声認識モデルのダウンロードが完了しました。
speech-recognition-model-download-failed-message = 音声認識モデルのダウンロードに失敗しました。
speech-recognition-model-download-ok =
    .label = OK
    .accesskey = O
